# Server Configuration
PORT=8080
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000

# Required for signed session tokens (generate a unique random value, 32+ chars)
AUTH_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Vite Frontend Configuration
VITE_API_URL=http://localhost:8080

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=euroasia_db
DB_PORT=3306

# AI Chatbot Configuration
# Đăng ký lấy API key miễn phí tại Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# (Tùy chọn) OpenAI API Key nếu muốn dùng OpenAI thay vì Gemini
OPENAI_API_KEY=

# Optional payment gateway credentials (leave blank to disable that gateway)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
VNP_TMNCODE=
VNP_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Optional: set these before `npm run admin:create`; password must be 12+ characters.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
