{
  "name": "euroasia-kitchen-frontend",
  "version": "1.0.0",
  "description": "Frontend website bán hàng dụng cụ bếp EuroAsia",
  "private": true,
  "dependencies": {
    "axios": "^1.3.4",
    "bootstrap": "^5.2.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.16.1",
    "qs": "^6.15.1",
    "react": "^18.2.0",
    "react-bootstrap": "^2.7.2",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^6.4.3",
    "wrangler": "^4.123.0"
  },
  "scripts": {
    "start": "node scripts/clean_ports.js && start cmd /k \"node server/index.js\" && vite --configLoader runner --port 3000",
    "dev": "node scripts/clean_ports.js && start cmd /k \"node server/index.js\" && vite --configLoader runner --port 3000",
    "run": "node scripts/clean_ports.js && start cmd /k \"node server/index.js\" && vite --configLoader runner --port 3000",
    "fix": "node scripts/clean_ports.js",
    "sync": "node server/sync_all_mysql.js",
    "server": "node scripts/clean_ports.js && node server/index.js",
    "clean:ports": "node scripts/clean_ports.js",
    "dev:server": "node scripts/clean_ports.js && node server/index.js",
    "dev:full": "node scripts/clean_ports.js && start cmd /k \"node server/index.js\" && vite --configLoader runner --port 3000",
    "sync:db": "node server/sync_all_mysql.js",
    "db:init": "node server/init_db.js",
    "migrate": "node server/migrate_payment.js",
    "migrate:ecommerce": "node server/migrate_ecommerce_features.js",
    "admin:create": "node server/create_admin.js",
    "build": "vite build --configLoader runner",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "live": "node scripts/live.js"
  }
}
